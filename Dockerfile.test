FROM php:8.3-apache

# System packages
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    ca-certificates \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libzip-dev \
    libgettextpo-dev \
    zip \
 && rm -rf /var/lib/apt/lists/*

# Configure GD
RUN docker-php-ext-configure gd --with-freetype --with-jpeg

# PHP extensions
RUN docker-php-ext-install \
    gd \
    intl \
    pdo_mysql \
    zip \
    gettext

# Apache modules
RUN a2enmod rewrite

# Apache configuration
RUN echo "HostnameLookups Off" >> /etc/apache2/apache2.conf
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Startup script
RUN cat > /usr/local/bin/docker-entrypoint-massi.sh <<'EOF'
#!/bin/sh

# mPDF temp directory permissions
if [ -d /var/www/html/vendor/mpdf/mpdf/tmp ]; then
    mkdir -p /var/www/html/vendor/mpdf/mpdf/tmp/mpdf
    chown -R www-data:www-data /var/www/html/vendor/mpdf/mpdf/tmp
    chmod -R 775 /var/www/html/vendor/mpdf/mpdf/tmp
fi

# Ohje-PDF:n oikeudet
if [ -f /var/www/html/docs/Massadigitointisovelluksen_pikaohje_2024.pdf ]; then
    chown www-data:www-data /var/www/html/docs/Massadigitointisovelluksen_pikaohje_2024.pdf
    chmod 644 /var/www/html/docs/Massadigitointisovelluksen_pikaohje_2024.pdf
fi

# settings.php:n oikeudet
if [ -f /var/www/html/settings.php ]; then
    chown www-data:www-data /var/www/html/settings.php
    chmod 644 /var/www/html/settings.php
fi

exec 